# TicketLens environment variables (reference only: the app reads them from the process environment
# and does not load a .env file automatically).

# "production" disables training at startup (Render / Docker)
TICKETLENS_ENV=development
# Overrides inference.confidence_threshold in configs/config.yaml
TICKETLENS_CONFIDENCE_THRESHOLD=0.80
# Optional: when set, /predict requires a matching X-API-Key header
TICKETLENS_API_KEY=
# Used by `python main.py` and the Docker image
PORT=8000
